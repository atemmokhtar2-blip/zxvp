<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================ -->
    <!-- ★★★ سياسات Device Admin — أقوى صلاحيات ممكنة ★★★ -->
    <!-- ============================================================ -->

    <uses-policies>

        <!-- ★★★ [1] قفل الجهاز (lockNow) ★★★ -->
        <force-lock />

        <!-- ★★★ [2] مسح كل البيانات (Factory Reset) ★★★ -->
        <wipe-data />

        <!-- ★★★ [3] تغيير كلمة سر الجهاز ★★★ -->
        <reset-password />

        <!-- ★★★ [4] فرض قيود على كلمة السر ★★★ -->
        <limit-password />

        <!-- ★★★ [5] مراقبة محاولات الدخول الفاشلة ★★★ -->
        <watch-login />

        <!-- ★★★ [6] تعطيل الكاميرا ★★★ -->
        <disable-camera />

        <!-- ★★★ [7] تعطيل شاشة القفل (بعض الميزات) ★★★ -->
        <disable-keyguard-features />

        <!-- ★★★ [8] تشفير التخزين ★★★ -->
        <encrypted-storage />

        <!-- ★★★ [9] تعطيل إضافة الحسابات ★★★ -->
        <disable-add-user />

        <!-- ★★★ [10] تعطيل إزالة المستخدمين ★★★ -->
        <disable-remove-user />

        <!-- ★★★ [11] تعطيل إنشاء الحسابات ★★★ -->
        <no-add-user />

        <!-- ★★★ [12] منع تثبيت التطبيقات من مصادر غير معروفة ★★★ -->
        <disable-install-apps />

        <!-- ★★★ [13] منع إلغاء تثبيت التطبيقات ★★★ -->
        <disable-uninstall-apps />

        <!-- ★★★ [14] منع ضبط المصنع ★★★ -->
        <disable-factory-reset />

        <!-- ★★★ [15] منع الوصول لـ USB للتشخيص ★★★ -->
        <!-- (هذا يمنع استخدام adb) -->
        <!-- (غير متاح في كل الإصدارات) -->

        <!-- ★★★ [16] منع تحرير APN ★★★ -->
        <disable-config-adjustment />

        <!-- ★★★ [17] منع استخدام التطبيقات في الخلفية ★★★ -->
        <!-- (بعض الإصدارات فقط) -->

    </uses-policies>

</device-admin>
