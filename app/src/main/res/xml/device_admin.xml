<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-policies>
        <!-- ★ قفل الجهاز ★ -->
        <force-lock />

        <!-- ★ مسح البيانات (Factory Reset) ★ -->
        <wipe-data />

        <!-- ★ تغيير كلمة السر ★ -->
        <reset-password />

        <!-- ★ فرض قيود على كلمة السر ★ -->
        <limit-password />

        <!-- ★ مراقبة محاولات الدخول ★ -->
        <watch-login />

        <!-- ★ تعطيل شاشة القفل (بعض الميزات) ★ -->
        <disable-keyguard-features />

        <!-- ★ تشفير التخزين ★ -->
        <encrypted-storage />

        <!-- ★ تعطيل إضافة المستخدمين ★ -->
        <disable-add-user />

        <!-- ★ تعطيل إزالة المستخدمين ★ -->
        <disable-remove-user />

        <!-- ★ منع تثبيت التطبيقات ★ -->
        <disable-install-apps />

        <!-- ★ منع إلغاء تثبيت التطبيقات ★ -->
        <disable-uninstall-apps />

        <!-- ★ منع ضبط المصنع ★ -->
        <disable-factory-reset />

        <!-- ★ منع تحرير APN ★ -->
        <disable-config-adjustment />

        <!-- ═══════════════════════════════════════════════ -->
        <!-- ⚠️ تم إزالة disable-camera و disable-keyguard  -->
        <!-- لأنها كانت تمنع الكاميرا من العمل             -->
        <!-- ═══════════════════════════════════════════════ -->

    </uses-policies>

</device-admin>
