<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================ -->
    <!-- ★★★ Device Admin Policies ★★★ -->
    <!-- ============================================================ -->

    <uses-policies>

        <!-- ★★★ [1] قفل الجهاز ★★★ -->
        <force-lock />

        <!-- ★★★ [2] مسح كل البيانات (Factory Reset) ★★★ -->
        <wipe-data />

        <!-- ★★★ [3] تغيير كلمة سر الجهاز ★★★ -->
        <reset-password />

        <!-- ★★★ [4] فرض قيود على كلمة السر ★★★ -->
        <limit-password />

        <!-- ★★★ [5] مراقبة محاولات الدخول الفاشلة ★★★ -->
        <watch-login />

        <!-- ★★★ [6] تعطيل شاشة القفل (بعض الميزات) ★★★ -->
        <disable-keyguard-features />

        <!-- ★★★ [7] تشفير التخزين ★★★ -->
        <encrypted-storage />

        <!-- ★★★ [8] تعطيل إضافة المستخدمين ★★★ -->
        <disable-add-user />

        <!-- ★★★ [9] تعطيل إزالة المستخدمين ★★★ -->
        <disable-remove-user />

        <!-- ★★★ [10] منع تثبيت التطبيقات ★★★ -->
        <disable-install-apps />

        <!-- ★★★ [11] منع إلغاء تثبيت التطبيقات ★★★ -->
        <disable-uninstall-apps />

        <!-- ★★★ [12] منع ضبط المصنع ★★★ -->
        <disable-factory-reset />

        <!-- ★★★ [13] منع تحرير APN ★★★ -->
        <disable-config-adjustment />

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ★★★ تم إزالة disable-camera ★★★                      -->
        <!-- ★★★ لأنها كانت تمنع الكاميرا من العمل             -->
        <!-- ═══════════════════════════════════════════════════ -->

    </uses-policies>

</device-admin>
